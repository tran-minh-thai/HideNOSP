# Maven
target/
*.class

# Raw data: never in git; datasets/README.md says where it comes from and how to fetch it.
# provenance.tsv alone DOES go into git: it holds only URLs, fetch dates, checksums and sizes,
# i.e. what lets someone else get exactly the bytes the paper used.
datasets/*
!datasets/README.md
!datasets/provenance.tsv

# Python probes
__pycache__/
*.pyc

# Leftovers of Git Bash on Windows
*.stackdump

# Editors, operating systems
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db

# The run procedure of the measuring machine lives OUTSIDE the repository, in the project root
# next to doc/ and paper/. Blocked here so that nobody adds it back by accident.
run.txt

# Result files ARE tracked: they are the evidence behind the tables of the paper.
# Do not add results*/ here.
