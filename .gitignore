# Maven
target/
*.class

# Dữ liệu thô: không vào git, xem datasets/README.md để biết nguồn và cách lấy.
# Riêng provenance.tsv thì CÓ vào git: nó chỉ chứa URL, ngày tải, tổng kiểm và kích thước,
# tức là thứ cho phép người khác lấy lại đúng bytes mà bài đã dùng.
datasets/*
!datasets/README.md
!datasets/provenance.tsv

# Python dò tìm
__pycache__/
*.pyc

# Rác của Git Bash trên Windows
*.stackdump

# Trình soạn thảo, hệ điều hành
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db

# Tệp kết quả ĐƯỢC theo dõi: chúng là bằng chứng cho các bảng trong bài.
# Không thêm results*/ vào đây.
